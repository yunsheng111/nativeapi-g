# =========================
# glm2api 示例配置
# =========================
# 使用方式：
# 1. 复制本文件为 `.env`
# 2. 填写 `GLM_REFRESH_TOKEN`，或开启游客模式
# 3. 按需修改监听地址、开放模型、服务鉴权等配置

# ---------------------------------
# 服务监听配置
# ---------------------------------
# 服务监听地址。
# 本机自用通常填 127.0.0.1；局域网共享可以改为 0.0.0.0。
HOST=127.0.0.1

# 服务端口。
# OpenAI SDK 常见写法会连到 http://127.0.0.1:8000/v1，所以默认保持 8000。
PORT=8000

# OpenAI 兼容接口前缀。
# 一般保持 /v1 即可，除非你已有反向代理规则。
API_PREFIX=/v1

# 日志级别：DEBUG / INFO / WARNING / ERROR
# 想看详细请求过程可改成 DEBUG。
LOG_LEVEL=INFO

# 调试狂暴模式。
# true: 自动切到 DEBUG，并打印入站原始请求、上游原始请求/响应、SSE 原文、工具调用转换等几乎所有调试信息。
DEBUG_DUMP_ALL=false

# 上游请求超时时间，单位秒。
# GLM Web 端在长回答和联网场景下会比较慢，默认给 120 秒更稳妥。
REQUEST_TIMEOUT_SECONDS=120

# CORS 允许来源。
# 前端本地调试可保留 *；若要收紧来源，可改成具体域名。
CORS_ALLOW_ORIGIN=*

# ---------------------------------
# 本服务自身鉴权（可选）
# ---------------------------------
# 如果你希望别人访问本地代理时也必须带 Bearer Token，可以在这里配置。
# 多个 key 用英文逗号分隔，例如：
# SERVER_API_KEYS=sk-local-1,sk-local-2
# 留空表示不校验访问者。
SERVER_API_KEYS=

# 结构化 API Key 管理（后台面板可增删改查，JSON 格式）。
# 通过管理面板添加会自动写回这里。
# 示例：[{"name":"my-key","key":"sk-xxx","enabled":true,"created_at":"2026-01-01 00:00:00"}]
# 留空则无需 API Key 即可访问（默认）。
GLM2API_API_KEYS=

# 管理面板登录密钥。
# 设置后可通过 /admin 访问管理面板（零依赖 SPA）。
# 默认值: glm2api-admin（如无需安全管控可保持默认）。
ADMIN_KEY=glm2api-admin

# ---------------------------------
# GLM / 智谱清言上游配置
# ---------------------------------
# 多账号 token 文件路径。
# 文件中每行一个 refresh_token，程序会优先使用这里的账号列表。
# 当某个账号请求失败时，会自动切到下一行账号继续尝试。
GLM_TOKEN_FILE=token.txt

# 单账号兜底配置。
# 如果没有 token.txt，才会使用这里的 refresh_token。
# 如果上游返回了新的 refresh_token，单账号模式下会自动写回当前 `.env` 文件；
# 多账号模式下则会写回 token.txt 对应账号行。
GLM_REFRESH_TOKEN=

# 显式启用游客 ck。
# true: 忽略 token.txt 和 GLM_REFRESH_TOKEN，直接走游客 token
# false: 正常优先使用 refresh_token；但如果完全没配 token，仍会自动退回游客模式
# 游客模式会按 GLM_MAX_CONCURRENCY 自动创建同等数量的游客账号槽位
GLM_USE_GUEST_REFRESH_TOKEN=false

# GLM Web 端基础地址。
# 默认已经对应 docs 中的 chatglm Web 接口，不建议修改。
GLM_BASE_URL=https://chatglm.cn/chatglm

# 默认 assistant_id
# docs 里使用的是 65940acff94777010aa6b796
# 大多数场景保留默认即可；如果你有自己的专属助手，也可以替换
GLM_ASSISTANT_ID=65940acff94777010aa6b796

# 图片生成接口默认使用的绘图 assistant_id
GLM_IMAGE_ASSISTANT_ID=65a232c082ff90a2ad2f15e2

# 是否在每次回答后删除 GLM 会话。
# true: 更干净，减少网页端聊天记录堆积
# false: 保留会话，方便你在上游网页端排查
GLM_DELETE_CONVERSATION=true

# 允许同时占用的上游执行槽位数量。
# 默认 3；P1-b（D3 拍板）后生产生效值取 6 —— 风控安全优先于吞吐，且单身份同时
# 只跑一条流。吞吐缺口由账号池规模补回（多真实账号时并发上限 = 账号数）。
# 游客模式下这个值同时决定会预创建多少个独立游客账号槽位。
GLM_MAX_CONCURRENCY=6

# 每次上游请求发起前的随机抖动上限，单位毫秒（0 = 关闭）。
# 打散同刻请求，避免"齐步走"的机器节奏（D3）。
GLM_REQUEST_JITTER_MS=200

# 每个游客槽首次请求前的随机延迟上限，单位秒（0 = 关闭）。
# 替代"服务启动瞬间 N 个全新设备同时注册"的农场特征（D3）。
GLM_GUEST_STAGGER_SECONDS=5

# 账号健康探测间隔，单位秒（P1-b，0 = 关闭）。
# 缓存内的账号零成本跳过；过期账号发真实刷新请求，连续失败达阈值自动摘除。
GLM_HEALTH_PROBE_SECONDS=300

# 健康探测 keepalive 批量（P2.5 第二批）：每轮真实续命的临期账号上限。
# 缓存剩余 TTL > 300s 的账号零成本确认、不占名额；0 = 不限量（旧行为）。
GLM_HEALTH_KEEPALIVE_BATCH=3

# ---- 上游传输（P2.5）----
# 传输通道：urllib（默认，Python 栈）| cdp（真实浏览器网络栈，attach 页面内同源 fetch）。
GLM_TRANSPORT=urllib
# 账号 BrowserContext 隔离池（P2.5 第二批，D2）：非游客账号各自专属浏览器
# context（cookie 与 Authorization 同源一致，消除身份混叠）；游客走浏览器默认身份。
# false 退回单 context 旧形态。
GLM_CDP_ACCOUNT_CONTEXTS=true
# CDP 浏览器参数：有头浏览器（headless 指纹与有头不同，风控对抗期建议有头）、
# 调试端口 0 = 随机分配、独立 profile 目录、传输级熔断（连续 N 次传输故障回落 urllib）。
GLM_CDP_HEADLESS=false
GLM_CDP_PORT=0
GLM_CDP_USER_DATA_DIR=_cdp_profile
GLM_CDP_ORIGIN=https://chatglm.cn
GLM_CDP_BREAKER_THRESHOLD=3
GLM_CDP_BREAKER_SECONDS=600

# ---- canary A/B 分流（P2.5 第二批，11.4）----
# 默认关闭：仅记录每请求的实际通道与结果（transport 记录），不改变选路。
# 开启后主力走默认通道，每 N 次放 1 次到另一通道做探针；探针连败 M 次淘汰
# 冷却；探针连续成功达阈值后打日志给出翻转默认通道的建议（是否翻转人工拍板）。
GLM_CANARY_ENABLED=false
GLM_CANARY_EVERY_N=20
GLM_CANARY_FAILURE_THRESHOLD=3
GLM_CANARY_COOLDOWN_SECONDS=600

# ---- 模式 B：内置工具运行时（P3）----
# 工具模式：passthrough（默认，工具由客户端执行）| builtin（中转端 agent loop 闭环）。
# 优先级：请求头 X-GLM2API-Tool-Mode > 模型名 @builtin 后缀 > 本全局值。
GLM_TOOL_MODE=passthrough
# 内置工具白名单（物理隔离：名单外的工具不注册、模型也无法调用）。
# 默认只读档；写/执行档需显式加入（逗号分隔）：
#   read_file, write_file, edit_file, list_dir, grep_files, delete_file, run_command, todo_write
GLM_BUILTIN_TOOLS=read_file, list_dir, grep_files, todo_write
# 文件工具沙箱根：所有文件操作限制在该目录内（拒绝 .. 与符号链接逃逸）。
GLM_TOOL_FS_ROOT=.
# builtin 模式单次请求的最大工具轮数（防模型循环调用失控）。
GLM_BUILTIN_MAX_ROUNDS=10
# run_command 超时（秒）；单次输出上限固定 1MB（见 glmrelay/tools/safety.py）。
GLM_SHELL_TIMEOUT_SECONDS=30

# 上游传输目标校验（P2）：是否阻断解析到私网地址的上游地址。
# 环回 / 链路本地（含云元数据）无条件阻断；TUN 代理 fake-IP 段（198.18.0.0/15）不受影响。
# 自建内网上游（如局域网网关）才需要设为 false。
GLM_TRANSPORT_BLOCK_PRIVATE=true

# 单条工具结果的字符上限（P2，0 = 不限制）。
# 超长结果保留首尾并注明截断，避免整页 HTML 撞上游单条消息 / 上下文上限（7.5.2）。
GLM_TOOL_RESULT_MAX_CHARS=24000

# 多请求排队最大等待时间，单位秒。
# 当并发请求超过上面的执行槽位数量时，会在这里等待空闲槽位。
GLM_QUEUE_WAIT_TIMEOUT_SECONDS=600

# 当 GLM 返回“请等待其他对话生成完毕”时，最多自动重试多少次。
# 这个重试主要用于兜住“网页端还有其他会话在生成”的情况。
GLM_BUSY_MAX_RETRIES=30

# 触发上面的忙碌重试时，两次重试之间等待多久，单位秒。
GLM_BUSY_RETRY_INTERVAL_SECONDS=2

# 游客 ck 请求失败时，最多自动重新拉取游客 token 并重试多少次。
GLM_GUEST_MAX_RETRIES=3

# 工具黑名单，多个名字用英文逗号分隔。
# 这些工具不会被注入到提示词里；即使模型仍然输出对应调用，也会在服务端被丢弃。
# 2API 不支持 web 端浏览器工具时，保留默认值即可。
BLOCKED_TOOL_NAMES=open_url,open_ul,browser.open,web.run,web.open,web.search,web_search,browse,open_link

# 自定义 User-Agent。
# 只有在你明确知道要伪装成其他浏览器时再改。
GLM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36 Edg/143.0.0.0
